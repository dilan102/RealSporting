generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Noticia {
  id        Int      @id @default(autoincrement())
  titulo    String
  resumen   String   @default("")
  contenido String
  imagen    String?
  fecha     DateTime @default(now())
  fechaFin  DateTime?
  categoria String
  publicada Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([fecha])
  @@index([fechaFin])
  @@index([publicada, fecha])
}

model Entrenamiento {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  imagen      String?
  imagenes    String[] @default([])
  videos      String[] @default([])
  fecha       DateTime @default(now())
  fechaFin    DateTime?
  oculto      Boolean  @default(false)
  publicado   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([fecha])
  @@index([fechaFin])
  @@index([publicado, fecha])
}

model Jugador {
  id             Int      @id @default(autoincrement())
  nombre         String
  numero         Int
  posicion       String
  bio            String
  imagen         String
  categoria      String
  convocado      Boolean  @default(false)
  visiblePublico Boolean  @default(false)
  publicado      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([publicado, visiblePublico])
  @@index([categoria])
}

model Torneo {
  id           Int      @id @default(autoincrement())
  nombre       String
  descripcion  String
  programacion String   @default("")
  sede         String   @default("")
  categoria    String   @default("")
  rival        String   @default("")
  imagen       String?
  fechaInicio  DateTime @default(now())
  fechaFin     DateTime?
  estado       String   @default("actual")
  publicado    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([estado, fechaInicio])
  @@index([publicado, fechaInicio])
  @@index([fechaFin])
}

/// Archivos subidos desde el panel admin (imágenes y videos persistentes en PostgreSQL).
model ArchivoSubido {
  id        String   @id @default(uuid())
  seccion   String
  mimeType  String
  contenido Bytes
  createdAt DateTime @default(now())

  @@index([seccion])
}

# EmailJS (formulario de inscripción en el cliente)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=tu_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=tu_template_id
# Public Key / User ID de EmailJS (no subir valores reales al repositorio)
NEXT_PUBLIC_EMAILJS_USER_ID=tu_public_key
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=tu_public_key

# Resend (respaldo para /api/registration si EmailJS no está configurado)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=onboarding@resend.dev

# Alternativa SMTP (formulario /api/registration)
GMAIL_USER=realsportingdeusmeed@gmail.com
GMAIL_APP_PASSWORD=tu_app_password

# Perfiles locales del panel de administración
# Editor de contenido: noticias, entrenamientos y jugadores.
ADMIN_USER=RealSporting
ADMIN_PASSWORD=RealSporting1985
# Administrador total: autoriza cambios globales del sitio.
OWNER_ADMIN_USER=DilanMM
OWNER_ADMIN_PASSWORD=santifjk

# Neon — en Connect verás dos URLs (o usa: vercel env pull .env)
# App / Vercel (con -pooler en el host):
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Prisma CLI: npm run db:push (SIN -pooler):
DIRECT_URL=postgresql://USUARIO:CLAVE@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# En Prisma <5.10 Neon a veces llamaba DATABASE_URL_UNPOOLED a la directa:
# DATABASE_URL_UNPOOLED=
# En Vercel las imágenes del panel admin se guardan en PostgreSQL (tabla ArchivoSubido).
# En servidor propio puedes usar disco persistente:
# REALSPORTING_STORAGE_DIR=/var/lib/real-sporting
# UPLOAD_STORAGE=disk|database (opcional; en Vercel se usa database automáticamente)
# Opcional: protege /api/cron/cleanup-expired (borra noticias y entrenamientos al llegar la fecha de fin).
CRON_SECRET=tu_secreto_para_cron

NEXT_PUBLIC_SITE_URL=https://real-sporting.vercel.app

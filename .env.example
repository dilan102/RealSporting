# EmailJS (formulario de inscripción en el cliente)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=tu_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=tu_template_id
# Public Key / User ID de EmailJS (no subir valores reales al repositorio)
NEXT_PUBLIC_EMAILJS_USER_ID=tu_public_key
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=tu_public_key

# Resend (respaldo para /api/registration si EmailJS no está configurado)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=onboarding@resend.dev

# Alternativa SMTP (formulario /api/registration)
GMAIL_USER=realsportingdeusmeed@gmail.com
GMAIL_APP_PASSWORD=tu_app_password

# NextAuth + GitHub OAuth (panel de administración)
NEXTAUTH_URL=https://real-sporting.vercel.app
NEXTAUTH_SECRET=genera_un_secreto_largo_aleatorio
GITHUB_ID=tu_github_oauth_client_id
GITHUB_SECRET=tu_github_oauth_client_secret
# Correos de GitHub autorizados (separados por coma). Vacío = cualquier cuenta GitHub.
GITHUB_ADMIN_USERS=admin@ejemplo.com

# Claves de API para gestores (alternativa a sesión GitHub)
TRAININGS_ACCESS_KEY=tu_clave_segura
NEWS_ACCESS_KEY=tu_clave_segura
ADMIN_PASSWORD=tu_clave_segura

# Base de datos PostgreSQL usada por Prisma
DATABASE_URL=postgresql://usuario:password@host:5432/base_de_datos?sslmode=require

NEXT_PUBLIC_SITE_URL=https://real-sporting.vercel.app
